#!/bin/bash
# discord-warp-fix (dwf)
# Keeps Discord usable when Cloudflare WARP's shared exit IPs get rate-limited.
#
#   reroll mode  watch Discord's log and move WARP to another exit IP on 429 bursts
#   tunnel mode  send Discord through an SSH SOCKS tunnel to a server you own
#   proxy mode   send Discord through an existing SOCKS5/HTTP proxy
#
# Compatible with the stock macOS /bin/bash (3.2).

set -u

VERSION="0.1.0"
LABEL_PREFIX="com.discord-warp-fix"
WATCH_LABEL="$LABEL_PREFIX.watch"
TUNNEL_LABEL="$LABEL_PREFIX.tunnel"

CONFIG_DIR="${DWF_CONFIG_DIR:-$HOME/.config/discord-warp-fix}"
CONFIG_FILE="$CONFIG_DIR/config"
STATE_DIR="${DWF_STATE_DIR:-$HOME/Library/Application Support/discord-warp-fix}"
LOG_FILE="${DWF_LOG_FILE:-$HOME/Library/Logs/discord-warp-fix.log}"
AGENT_DIR="${DWF_AGENT_DIR:-$HOME/Library/LaunchAgents}"
SHARE_DIR="${DWF_SHARE_DIR:-$HOME/.local/share/discord-warp-fix}"

export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

TRACE_URL="https://www.cloudflare.com/cdn-cgi/trace"
DISCORD_PROBE_URL="https://discord.com/api/v9/experiments"
IP_ECHO_URL="https://api.ipify.org"
ERROR_PATTERN='\[429\]|Failed to fetch messages'

# ---------------------------------------------------------------- defaults ---
MODE="reroll"            # reroll | tunnel | proxy
SSH_HOST=""
SSH_USER="dwf"
SSH_PORT="22"
SSH_KEY="$HOME/.ssh/discord-warp-fix_ed25519"
SOCKS_PORT="1080"
PROXY_URL=""             # proxy mode only, e.g. socks5://203.0.113.7:1080
THRESHOLD="5"            # errors inside WINDOW that count as a rate-limit burst
WINDOW="120"             # seconds
COOLDOWN="300"           # seconds between automatic actions
POLL="5"                 # seconds between log checks
REROLL_ATTEMPTS="6"
AUTO_RELAUNCH="1"        # tunnel/proxy: relaunch a freshly started Discord through the proxy
FALLBACK_AFTER="120"     # tunnel/proxy: seconds of proxy failure before Discord is relaunched
                         # directly through WARP (0 = never, only notify)
NOTIFY="1"
DISCORD_APP="Discord"    # or "Discord PTB" / "Discord Canary"
DISCORD_LOG=""           # derived from DISCORD_APP when empty

# ----------------------------------------------------------------- helpers ---
log() {
  mkdir -p "$(dirname "$LOG_FILE")"
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"
}

say() { printf '%s\n' "$*"; }
die() { printf 'dwf: %s\n' "$*" >&2; exit 1; }

notify() {
  [ "$NOTIFY" = "1" ] || return 0
  osascript -e 'on run argv' \
            -e 'display notification (item 1 of argv) with title "Discord WARP Fix"' \
            -e 'end run' "$1" >/dev/null 2>&1 || true
}

derive_paths() {
  if [ -z "$DISCORD_LOG" ]; then
    local data_dir
    case "$DISCORD_APP" in
      "Discord PTB")    data_dir="discordptb" ;;
      "Discord Canary") data_dir="discordcanary" ;;
      *)                data_dir="discord" ;;
    esac
    DISCORD_LOG="$HOME/Library/Application Support/$data_dir/logs/renderer_js.log"
  fi
}

load_config() {
  if [ -f "$CONFIG_FILE" ]; then
    # shellcheck source=/dev/null
    . "$CONFIG_FILE"
  fi
  derive_paths
}

write_config() {
  mkdir -p "$CONFIG_DIR"
  local tmp="$CONFIG_FILE.tmp.$$" key
  {
    say "# discord-warp-fix config. Edit, then run: dwf install"
    for key in MODE SSH_HOST SSH_USER SSH_PORT SSH_KEY SOCKS_PORT PROXY_URL \
               THRESHOLD WINDOW COOLDOWN POLL REROLL_ATTEMPTS AUTO_RELAUNCH FALLBACK_AFTER NOTIFY DISCORD_APP; do
      eval "printf '%s=%q\n' \"$key\" \"\${$key}\""
    done
  } > "$tmp" && mv "$tmp" "$CONFIG_FILE"
  chmod 600 "$CONFIG_FILE"
}

# "[[dd-]hh:]mm:ss" from ps etime -> seconds
etime_to_seconds() {
  local t="$1" d=0 h=0 m=0 s=0 a b c
  case "$t" in *-*) d="${t%%-*}"; t="${t#*-}" ;; esac
  IFS=: read -r a b c <<< "$t"
  if [ -n "$c" ]; then h="$a"; m="$b"; s="$c"; else m="$a"; s="$b"; fi
  echo $(( 10#$d * 86400 + 10#$h * 3600 + 10#$m * 60 + 10#$s ))
}

count_errors() { grep -cE "$ERROR_PATTERN" || true; }

# prune_events "<epochs...>" <oldest-allowed>
prune_events() {
  local out="" e
  for e in $1; do [ "$e" -ge "$2" ] && out="$out $e"; done
  echo "${out# }"
}

# shellcheck disable=SC2086
word_count() { set -- $1; echo $#; }

# -------------------------------------------------------------------- WARP ---
have_warp() { command -v warp-cli >/dev/null 2>&1; }
warp() { warp-cli --accept-tos "$@"; }

exit_ip() { curl -s --max-time 8 "$TRACE_URL" 2>/dev/null | sed -n 's/^ip=//p'; }

warp_protocol() { warp tunnel stats 2>/dev/null | sed -n 's/^Tunnel Protocol: \([A-Za-z]*\).*/\1/p'; }

warp_status() { warp status 2>/dev/null | sed -n 's/^Status update: //p' | head -1; }

wait_for_exit_ip() {
  local i=0 ip=""
  while [ $i -lt 15 ]; do
    ip="$(exit_ip)"
    [ -n "$ip" ] && { echo "$ip"; return 0; }
    sleep 2; i=$((i + 1))
  done
  return 1
}

# ----------------------------------------------------------------- Discord ---
discord_pid() { pgrep -f "^/Applications/$DISCORD_APP.app/Contents/MacOS/" 2>/dev/null | head -1; }

discord_age() {
  local et
  et="$(ps -o etime= -p "$1" 2>/dev/null | tr -d ' ')"
  [ -n "$et" ] && etime_to_seconds "$et"
}

discord_proxied() { ps -o args= -p "$1" 2>/dev/null | grep -q -- '--proxy-server='; }

quit_discord() {
  local pid i=0
  pid="$(discord_pid)"
  [ -n "$pid" ] || return 0
  osascript -e "quit app \"$DISCORD_APP\"" >/dev/null 2>&1 || true
  while [ $i -lt 20 ] && [ -n "$(discord_pid)" ]; do sleep 1; i=$((i + 1)); done
  pid="$(discord_pid)"
  if [ -n "$pid" ]; then kill -TERM "$pid" 2>/dev/null; sleep 2; fi
}

# ------------------------------------------------------------------- proxy ---
proxy_url() {
  case "$MODE" in
    tunnel) echo "socks5://127.0.0.1:$SOCKS_PORT" ;;
    proxy)  echo "$PROXY_URL" ;;
    *)      echo "" ;;
  esac
}

# curl needs socks5h:// to resolve names on the proxy side, like Chromium does.
curl_proxy() { proxy_url | sed 's#^socks5://#socks5h://#'; }

proxy_healthy() {
  local p code
  p="$(curl_proxy)"; [ -n "$p" ] || return 1
  code="$(curl -s -o /dev/null -w '%{http_code}' -x "$p" --max-time 10 "$DISCORD_PROBE_URL" 2>/dev/null)"
  [ "$code" = "200" ]
}

proxy_exit_ip() {
  local p; p="$(curl_proxy)"; [ -n "$p" ] || return 1
  curl -s -x "$p" --max-time 10 "$IP_ECHO_URL" 2>/dev/null
}

ssh_tunnel_opts() {
  echo "-n -N -D 127.0.0.1:$SOCKS_PORT -p $SSH_PORT -i $SSH_KEY -o BatchMode=yes -o IdentitiesOnly=yes -o ExitOnForwardFailure=yes -o ConnectTimeout=15 -o StrictHostKeyChecking=accept-new"
}

# --------------------------------------------------------------- commands ---
cmd_reroll() {
  have_warp || die "warp-cli not found. Is Cloudflare WARP installed?"
  local max="${1:-$REROLL_ATTEMPTS}" before after cur next i=1
  before="$(exit_ip)"
  [ -n "$before" ] || die "can't reach Cloudflare through WARP. Is it connected?"
  say "current WARP exit: $before"
  while [ $i -le "$max" ]; do
    cur="$(warp_protocol)"
    if [ "$cur" = "WireGuard" ]; then next="MASQUE"; else next="WireGuard"; fi
    warp tunnel protocol set "$next" >/dev/null 2>&1 || die "warp-cli refused to switch protocol"
    sleep 4
    after="$(wait_for_exit_ip)" || after=""
    log "reroll attempt $i/$max: protocol=$next exit=${after:-none}"
    say "attempt $i/$max: $next -> ${after:-no connection yet}"
    if [ -n "$after" ] && [ "$after" != "$before" ]; then
      say "exit IP changed: $before -> $after"
      log "reroll success: $before -> $after"
      return 0
    fi
    i=$((i + 1))
  done
  say "exit IP is still $before after $max attempts"
  log "reroll failed: stayed on $before"
  return 1
}

cmd_launch() {
  local direct=0 force=0 url i=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --direct) direct=1 ;;
      --force)  force=1 ;;
      *) die "unknown option for launch: $1" ;;
    esac
    shift
  done
  if [ $direct = 1 ]; then
    quit_discord; open -a "$DISCORD_APP"; say "Discord relaunched without a proxy."; return 0
  fi
  url="$(proxy_url)"
  [ -n "$url" ] || die "launch needs tunnel or proxy mode (current mode: $MODE). Use --direct for a plain relaunch."
  if [ $force = 0 ]; then
    until proxy_healthy; do
      i=$((i + 1))
      [ $i -gt 15 ] && die "the proxy at $url isn't reaching Discord. Check 'dwf status', or use --force."
      sleep 2
    done
  fi
  quit_discord
  open -a "$DISCORD_APP" --args --proxy-server="$url"
  log "launched $DISCORD_APP via $url"
  say "Discord relaunched through $url"
}

cmd_tunnel() {
  [ "$MODE" = "tunnel" ] || die "tunnel only runs in tunnel mode (current mode: $MODE)"
  [ -n "$SSH_HOST" ] || die "SSH_HOST is empty. Run: dwf setup"
  [ -f "$SSH_KEY" ] || die "SSH key $SSH_KEY is missing. Run: dwf setup"
  log "tunnel: connecting to $SSH_USER@$SSH_HOST:$SSH_PORT, SOCKS on 127.0.0.1:$SOCKS_PORT"
  # shellcheck disable=SC2046
  exec ssh $(ssh_tunnel_opts) -o ServerAliveInterval=15 -o ServerAliveCountMax=3 "$SSH_USER@$SSH_HOST"
}

# One pass of the watchdog. Reads new log lines, updates EVENTS.
# Returns 0 when a rate-limit burst is detected and the cooldown has passed.
W_OFFSET=-1
W_INODE=""
EVENTS=""
LAST_ACTION=0
watch_tick() {
  local now size inode n i
  now="${1:-$(date +%s)}"
  if [ -f "$DISCORD_LOG" ]; then
    inode="$(stat -f %i "$DISCORD_LOG")"
    size="$(stat -f %z "$DISCORD_LOG")"
    if [ "$W_OFFSET" -lt 0 ]; then
      W_OFFSET="$size"; W_INODE="$inode"          # skip history on startup
    elif [ "$inode" != "$W_INODE" ] || [ "$size" -lt "$W_OFFSET" ]; then
      W_OFFSET=0; W_INODE="$inode"                # log rotated
    fi
    if [ "$size" -gt "$W_OFFSET" ]; then
      n="$(tail -c +"$((W_OFFSET + 1))" "$DISCORD_LOG" | head -c "$((size - W_OFFSET))" | count_errors)"
      W_OFFSET="$size"
      i=0; while [ "$i" -lt "$n" ]; do EVENTS="$EVENTS $now"; i=$((i + 1)); done
    fi
  fi
  EVENTS="$(prune_events "$EVENTS" $((now - WINDOW)))"
  [ "$(word_count "$EVENTS")" -ge "$THRESHOLD" ] && [ $((now - LAST_ACTION)) -ge "$COOLDOWN" ]
}

handle_burst() {
  local count="$1" pid old new
  log "rate-limit burst: $count errors in ${WINDOW}s (mode=$MODE)"
  case "$MODE" in
    reroll)
      old="$(exit_ip)"
      if cmd_reroll >/dev/null 2>&1; then
        new="$(exit_ip)"
        notify "Discord was rate-limited on WARP exit $old. Moved to $new."
      else
        notify "Discord is rate-limited on WARP exit $old and no other exit was available. Will retry in $((COOLDOWN / 60)) min."
      fi
      ;;
    tunnel|proxy)
      pid="$(discord_pid)"
      if [ -n "$pid" ] && ! discord_proxied "$pid"; then
        notify "Discord is rate-limited because it isn't using your proxy. Run: dwf launch"
      elif ! proxy_healthy; then
        log "proxy unhealthy during burst"
        [ "$MODE" = "tunnel" ] && launchctl kickstart -k "gui/$(id -u)/$TUNNEL_LABEL" >/dev/null 2>&1
        notify "Your Discord proxy isn't responding. Restarting the tunnel."
      else
        notify "Discord is rate-limited even through your proxy ($(proxy_exit_ip)). Check 'dwf status'."
      fi
      ;;
  esac
}

RELAUNCHED_PID=""
ensure_proxied_launch() {
  [ "$AUTO_RELAUNCH" = "1" ] || return 0
  local pid age
  pid="$(discord_pid)"
  [ -n "$pid" ] || return 0
  [ "$pid" = "$RELAUNCHED_PID" ] && return 0
  discord_proxied "$pid" && return 0
  age="$(discord_age "$pid")"
  { [ -n "$age" ] && [ "$age" -le 180 ]; } || return 0
  RELAUNCHED_PID="$pid"
  if proxy_healthy; then
    log "fresh Discord (pid $pid, ${age}s old) started without proxy, relaunching"
    cmd_launch >/dev/null 2>&1 || log "auto relaunch failed"
    RELAUNCHED_PID="$(discord_pid)"
  else
    log "fresh Discord started without proxy, but the proxy is down; leaving it alone"
  fi
}

# Tunnel/proxy modes: keep Discord usable when the proxy dies.
PROXY_DOWN_SINCE=0
LAST_HEALTH=0
FELL_BACK=0
check_proxy_health() {
  local now pid
  now="${1:-$(date +%s)}"
  [ $((now - LAST_HEALTH)) -ge 30 ] || return 0
  LAST_HEALTH="$now"
  if proxy_healthy; then
    if [ "$PROXY_DOWN_SINCE" != 0 ]; then
      log "proxy reaches Discord again"
      [ "$FELL_BACK" = 1 ] && notify "Your Discord proxy is back. Run 'dwf launch' to use it again."
    fi
    PROXY_DOWN_SINCE=0; FELL_BACK=0
    return 0
  fi
  pid="$(discord_pid)"
  { [ -n "$pid" ] && discord_proxied "$pid"; } || return 0
  if [ "$PROXY_DOWN_SINCE" = 0 ]; then
    PROXY_DOWN_SINCE="$now"; log "proxy stopped reaching Discord"
    return 0
  fi
  [ "$FELL_BACK" = 0 ] && [ $((now - PROXY_DOWN_SINCE)) -ge "${FALLBACK_AFTER:-120}" ] || return 0
  FELL_BACK=1
  if [ "$FALLBACK_AFTER" = 0 ]; then
    notify "Your Discord proxy is down. Run 'dwf launch --direct' to use WARP directly."
  else
    log "proxy down for $((now - PROXY_DOWN_SINCE))s, relaunching Discord directly through WARP"
    cmd_launch --direct >/dev/null 2>&1
    RELAUNCHED_PID="$(discord_pid)"   # don't bounce it straight back onto the dead proxy
    notify "Your Discord proxy has been down for a while, so Discord now runs directly through WARP."
  fi
}

cmd_watch() {
  mkdir -p "$STATE_DIR"
  LAST_ACTION="$(cat "$STATE_DIR/last_action" 2>/dev/null || echo 0)"
  log "watchdog $VERSION started (mode=$MODE threshold=$THRESHOLD/${WINDOW}s cooldown=${COOLDOWN}s)"
  while true; do
    if watch_tick; then
      handle_burst "$(word_count "$EVENTS")"
      LAST_ACTION="$(date +%s)"; EVENTS=""
      echo "$LAST_ACTION" > "$STATE_DIR/last_action"
    fi
    case "$MODE" in tunnel|proxy) check_proxy_health; ensure_proxied_launch ;; esac
    sleep "$POLL"
  done
}

agent_loaded() { launchctl print "gui/$(id -u)/$1" >/dev/null 2>&1; }

# rate-limit errors Discord logged in the last N minutes (default 10)
recent_errors() {
  local mins="${1:-10}" since
  [ -f "$DISCORD_LOG" ] || { echo 0; return; }
  since="$(date -v-"${mins}"M '+%Y-%m-%d %H:%M:%S')"
  awk -v since="[$since" 'substr($0,1,20) >= since' "$DISCORD_LOG" 2>/dev/null | count_errors
}

cmd_status() {
  local pid ip proto st
  say "discord-warp-fix $VERSION  (mode: $MODE, config: $CONFIG_FILE)"
  say ""
  if have_warp; then
    st="$(warp_status)"; proto="$(warp_protocol)"; ip="$(exit_ip)"
    say "WARP        ${st:-unknown}, protocol ${proto:-unknown}, exit IP ${ip:-unreachable}"
  else
    say "WARP        warp-cli not found"
  fi
  pid="$(discord_pid)"
  if [ -z "$pid" ]; then
    say "Discord     not running"
  elif discord_proxied "$pid"; then
    say "Discord     running through $(ps -o args= -p "$pid" | grep -oE -- '--proxy-server=[^ ]+' | cut -d= -f2)"
  else
    say "Discord     running directly (no proxy)"
  fi
  say "Errors      $(recent_errors 10) rate-limit errors in Discord's log in the last 10 min"
  if [ "$MODE" != "reroll" ]; then
    if proxy_healthy; then
      say "Proxy       $(proxy_url) reaches Discord, exit IP $(proxy_exit_ip)"
    else
      say "Proxy       $(proxy_url) is NOT reaching Discord"
    fi
  fi
  say "Watchdog    $(agent_loaded "$WATCH_LABEL" && echo running || echo 'not installed')"
  [ "$MODE" = "tunnel" ] && say "Tunnel      $(agent_loaded "$TUNNEL_LABEL" && echo running || echo 'not installed')"
  say "Log         $LOG_FILE"
}

self_path() {
  local p="$0"
  case "$p" in /*) ;; *) p="$PWD/$p" ;; esac
  echo "$p"
}

plist_path() { echo "${AGENT_DIR:?}/${1:?}.plist"; }

write_plist() {
  local label="$1" arg="$2" plist
  plist="$(plist_path "$label")"
  mkdir -p "$AGENT_DIR" "$(dirname "$LOG_FILE")"
  cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$(self_path)</string>
    <string>$arg</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>$LOG_FILE</string>
  <key>StandardErrorPath</key><string>$LOG_FILE</string>
</dict>
</plist>
EOF
  plutil -lint "$plist" >/dev/null || die "generated an invalid plist: $plist"
  echo "$plist"
}

load_agent() {
  local uid; uid="$(id -u)"
  launchctl bootout "gui/$uid/$1" >/dev/null 2>&1 || true
  launchctl bootstrap "gui/$uid" "$(plist_path "$1")" || die "launchctl couldn't load $1"
}

unload_agent() {
  launchctl bootout "gui/$(id -u)/$1" >/dev/null 2>&1 || true
  rm -f -- "$(plist_path "$1")"
}

cmd_install() {
  [ -f "$CONFIG_FILE" ] || write_config
  case "$MODE" in reroll|tunnel|proxy) ;; *) die "MODE must be reroll, tunnel or proxy" ;; esac
  if [ "$MODE" = "tunnel" ]; then
    [ -n "$SSH_HOST" ] || die "tunnel mode needs SSH_HOST. Run: dwf setup"
    write_plist "$TUNNEL_LABEL" tunnel >/dev/null; load_agent "$TUNNEL_LABEL"
    say "tunnel agent installed"
  else
    unload_agent "$TUNNEL_LABEL"
  fi
  write_plist "$WATCH_LABEL" watch >/dev/null; load_agent "$WATCH_LABEL"
  say "watchdog installed (mode: $MODE). It starts at login and restarts if it dies."
  log "installed agents (mode=$MODE)"
}

cmd_uninstall() {
  unload_agent "$WATCH_LABEL"; unload_agent "$TUNNEL_LABEL"
  say "agents removed."
  if [ "${1:-}" = "--purge" ]; then
    rm -rf -- "${CONFIG_DIR:?}" "${STATE_DIR:?}"; say "config and state removed."
  fi
}

ask() { # ask "question" default -> answer
  local a=""
  if [ -r /dev/tty ]; then
    printf '%s [%s]: ' "$1" "$2" > /dev/tty
    IFS= read -r a < /dev/tty || a=""
  fi
  echo "${a:-$2}"
}

server_script() {
  local p
  for p in "$SHARE_DIR/setup-server.sh" "$(dirname "$(self_path)")/../server/setup-server.sh"; do
    [ -f "$p" ] && { echo "$p"; return 0; }
  done
  return 1
}

cmd_setup() {
  local interactive=1 admin="" script pub
  while [ $# -gt 0 ]; do
    case "$1" in
      --mode)  MODE="$2"; shift ;;
      --host)  SSH_HOST="$2"; shift ;;
      --user)  SSH_USER="$2"; shift ;;
      --port)  SSH_PORT="$2"; shift ;;
      --key)   SSH_KEY="$2"; shift ;;
      --socks-port) SOCKS_PORT="$2"; shift ;;
      --proxy) PROXY_URL="$2"; shift ;;
      --admin) admin="$2"; shift ;;
      --yes|-y) interactive=0 ;;
      *) die "unknown option for setup: $1" ;;
    esac
    shift
  done
  [ -r /dev/tty ] || interactive=0

  if [ $interactive = 1 ]; then
    say "Modes:"
    say "  reroll  free. Moves WARP to another shared exit IP when Discord gets rate-limited."
    say "  tunnel  complete fix. Sends Discord through an SSH tunnel to a server you control."
    say "  proxy   sends Discord through a SOCKS5/HTTP proxy you already have."
    MODE="$(ask "Mode" "$MODE")"
  fi
  case "$MODE" in reroll|tunnel|proxy) ;; *) die "mode must be reroll, tunnel or proxy" ;; esac

  if [ "$MODE" = "proxy" ]; then
    [ $interactive = 1 ] && PROXY_URL="$(ask "Proxy URL (socks5://host:port or http://host:port)" "$PROXY_URL")"
    [ -n "$PROXY_URL" ] || die "proxy mode needs a proxy URL"
  fi

  if [ "$MODE" = "tunnel" ]; then
    if [ $interactive = 1 ]; then
      SSH_HOST="$(ask "Server address (IP or hostname)" "$SSH_HOST")"
      SSH_PORT="$(ask "Server SSH port" "$SSH_PORT")"
      SSH_USER="$(ask "Tunnel user on the server" "$SSH_USER")"
    fi
    [ -n "$SSH_HOST" ] || die "tunnel mode needs a server address"
    if [ ! -f "$SSH_KEY" ]; then
      mkdir -p "$(dirname "$SSH_KEY")"
      ssh-keygen -q -t ed25519 -N "" -C "discord-warp-fix@$(hostname -s)" -f "$SSH_KEY" || die "ssh-keygen failed"
      say "created SSH key $SSH_KEY"
    fi
    pub="$(cat "$SSH_KEY.pub")"
    script="$(server_script)" || die "can't find setup-server.sh. Reinstall with install.sh."
    if [ -z "$admin" ] && [ $interactive = 1 ]; then
      admin="$(ask "Admin login on the server to prepare it now (e.g. root), or leave empty to do it yourself" "")"
    fi
    if [ -n "$admin" ]; then
      say "preparing $SSH_HOST as $admin (you may be asked for a password)..."
      ssh -p "$SSH_PORT" "$admin@$SSH_HOST" "cat > /tmp/dwf-setup-server.sh" < "$script" || die "couldn't copy the server script"
      ssh -t -p "$SSH_PORT" "$admin@$SSH_HOST" \
        "if [ \"\$(id -u)\" = 0 ]; then S=; else S=sudo; fi; \$S env DWF_USER='$SSH_USER' bash /tmp/dwf-setup-server.sh '$pub'; rc=\$?; rm -f /tmp/dwf-setup-server.sh; exit \$rc" \
        || die "server setup failed"
    else
      say ""
      say "Prepare the server yourself: copy $script to it and run as root:"
      say "  sudo env DWF_USER=$SSH_USER bash setup-server.sh '$pub'"
      say ""
    fi
  fi

  write_config
  say "saved $CONFIG_FILE"
  cmd_check || true
  say ""
  say "Next: dwf install"
  [ "$MODE" != "reroll" ] && say "Then: dwf launch   (relaunches Discord through the proxy)"
  return 0
}

cmd_check() {
  local pid warp_ip via="" ok=0 i=0
  warp_ip="$(exit_ip)"
  case "$MODE" in
    reroll)
      say "WARP exit IP: ${warp_ip:-unreachable}"
      [ -n "$warp_ip" ] ;;
    proxy)
      if proxy_healthy; then say "proxy reaches Discord, exit IP $(proxy_exit_ip)"; else say "proxy does NOT reach Discord"; return 1; fi ;;
    tunnel)
      if agent_loaded "$TUNNEL_LABEL" && proxy_healthy; then ok=1; via="$(proxy_exit_ip)"; fi
      if [ $ok = 0 ]; then
        say "testing SSH tunnel to $SSH_USER@$SSH_HOST:$SSH_PORT ..."
        # shellcheck disable=SC2046,SC2029
        ssh $(ssh_tunnel_opts) "$SSH_USER@$SSH_HOST" &
        pid=$!
        while [ $i -lt 10 ]; do sleep 1; proxy_healthy && { ok=1; break; }; i=$((i + 1)); done
        [ $ok = 1 ] && via="$(proxy_exit_ip)"
        kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
      fi
      if [ $ok = 1 ]; then
        say "tunnel works. Discord would leave from $via (WARP's shared exit is ${warp_ip:-unknown})."
        [ "$via" = "$warp_ip" ] && say "warning: that's the same IP as WARP's shared exit, so this won't avoid the rate limit. Use a server outside this network."
      else
        say "tunnel test FAILED. Check the server address, port and that setup-server.sh ran."
        return 1
      fi ;;
  esac
}

cmd_logs() { tail -n "${1:-40}" "$LOG_FILE" 2>/dev/null || say "no log yet at $LOG_FILE"; }

usage() {
  cat <<EOF
discord-warp-fix $VERSION: keep Discord working behind Cloudflare WARP's shared exit IPs

Usage: dwf <command>

  setup [--mode M ...]  choose a mode and write the config (interactive)
  install               install and start the background agents
  uninstall [--purge]   remove agents (and config with --purge)
  status                show WARP, Discord, proxy and agent state
  check                 test the configured mode end to end
  launch [--direct]     relaunch Discord through the proxy (or without it)
  reroll [N]            move WARP to a different exit IP now
  logs [N]              show the last N lines of dwf's log
  watch                 run the watchdog in the foreground (used by launchd)
  tunnel                run the SSH tunnel in the foreground (used by launchd)
  version

Config: $CONFIG_FILE
EOF
}

main() {
  load_config
  local cmd="${1:-help}"; [ $# -gt 0 ] && shift
  case "$cmd" in
    setup)     cmd_setup "$@" ;;
    install)   cmd_install ;;
    uninstall) cmd_uninstall "$@" ;;
    status)    cmd_status ;;
    check)     cmd_check ;;
    launch)    cmd_launch "$@" ;;
    reroll)    cmd_reroll "$@" ;;
    logs)      cmd_logs "$@" ;;
    watch)     cmd_watch ;;
    tunnel)    cmd_tunnel ;;
    version|--version) say "$VERSION" ;;
    help|-h|--help) usage ;;
    *) usage; exit 2 ;;
  esac
}

if [ "${DWF_SOURCE_ONLY:-0}" != "1" ]; then main "$@"; fi
